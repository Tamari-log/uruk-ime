# コピーして keystore.properties を作成し、値を埋めてください（keystore.properties は Git に含めない）。
# 例: copy keystore.properties.example keystore.properties
#
# アップロード用キーストアの作成例（Google の案内に従い、パスワードは安全に管理）:
#   keytool -genkeypair -v -keystore release/upload.jks -alias upload -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile はリポジトリルートからの相対パス推奨（この例では release/upload.jks をルートに置く想定）

storeFile=release/upload.jks
storePassword=your_store_password
keyAlias=upload
keyPassword=your_key_password
