# このファイルをコピーして keystore.properties を作成し、値を実環境用に置き換えてください。
# keystore.properties は .gitignore 対象のためリポジトリには含めません。
#
# 例（PowerShell）: Copy-Item keystore.properties.example keystore.properties
#
# キーストア作成の例（Google の案内に従うこと）:
#   keytool -genkeypair -v -keystore release/upload.jks -alias upload -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile はリポジトリルートからの相対パス推奨。

storeFile=release/upload.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
